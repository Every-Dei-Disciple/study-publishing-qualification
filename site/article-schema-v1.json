{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Study bounded publication fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "slug", "title", "appearance", "paragraphs", "references"],
  "properties": {
    "schemaVersion": {"const": 1, "type": "integer"},
    "id": {"type": "string", "format": "uuid"},
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "appearance": {"enum": ["Light", "Dark", "Paper"]},
    "paragraphs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "references": {"type": "array", "items": {
      "type": "object", "additionalProperties": false, "required": ["id", "title", "url"],
      "properties": {"id": {"type": "integer", "minimum": 1}, "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "pattern": "^https://", "format": "uri"}}
    }}
  }
}
